# NameCraft AI 로컬 설정 예시 — 복사해서 .env 로 사용 (모두 선택 항목)
# 유료 AI API 키 항목은 존재하지 않습니다 (기획서 §33.1).

# NAMECRAFT_ENV=local
# NAMECRAFT_VAR_DIR=./var
# NAMECRAFT_DATABASE_URL=sqlite:///./var/namecraft.db
# NAMECRAFT_DATABASE_URL=postgresql+psycopg://namecraft:namecraft@localhost:5432/namecraft
# NAMECRAFT_TOKEN_FILE=./var/local_token
# NAMECRAFT_CORS_ORIGINS=["http://localhost:3000"]

# 웹(Next.js 서버 측 프록시)
# NAMECRAFT_API_URL=http://127.0.0.1:8000
